<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Id="SugioLabs.Desktop"
    Name="Sugio Labs"
    Manufacturer="SUGIO LABSS"
    Version="1.0.0"
    Scope="perMachine">

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Sugio Labs">
        <Component Id="MainExecutable" Bitness="always64">
          <File
            Id="SugioLabsExe"
            Source="..\..\native\publish\SugioLabs.exe"
            KeyPath="yes">
            <Shortcut
              Id="StartMenuShortcut"
              Directory="ProgramMenuFolder"
              Name="Sugio Labs"
              Description="Sugio Labs local AI software development workspace"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="yes" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="MainFeature" Title="Sugio Labs" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Package>
</Wix>
