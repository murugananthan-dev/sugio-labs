# Sugio Labs Configuration
APP_NAME=Sugio Labs
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Ollama / Local AI Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=llama3:8b
FALLBACK_MODEL=qwen2.5-coder:7b
OFFLINE_MODE=true

# Database (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./data/sugio_labs.db

# Workspace Sandbox (Local Projects Directory)
WORKSPACE_ROOT=./projects_sandbox

# Security / Permissions
STRICT_PERMISSIONS=true
