<Window x:Class="SugioLabs.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sugio Labs"
        Width="1480"
        Height="920"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0E1424" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="S" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Sugio Labs" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Native AI software workspace" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="PageTitleText"
                           Grid.Column="1"
                           Text="Plan"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="BackendStatusDot" Width="9" Height="9" Fill="#6A7286" Margin="0,0,8,0" />
                    <TextBlock x:Name="BackendStatusText" Text="Starting Python backend..." Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0E1424" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,18">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="WORKSPACE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,0,0,12" />
                        <Button Content="Plan" Tag="Plan" Click="NavButton_Click" />
                        <Button Content="Blueprint" Tag="Blueprint" Click="NavButton_Click" />
                        <Button Content="Contracts" Tag="Contracts" Click="NavButton_Click" />
                        <Button Content="Impact" Tag="Impact" Click="NavButton_Click" />
                        <Button Content="Git Safety" Tag="Git" Click="NavButton_Click" />
                        <Button Content="Assistant" Tag="Assistant" Click="NavButton_Click" />
                        <Button Content="System" Tag="System" Click="NavButton_Click" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}" Margin="0,18,0,0" Padding="12">
                        <StackPanel>
                            <TextBlock Text="LOCAL FIRST" FontSize="10" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" />
                            <TextBlock Text="Python backend runs only on this PC. Project actions stay behind explicit permission gates." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="22,20">
                <ScrollViewer x:Name="PlanPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Project planning" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Text="Shape the software before code changes begin. The Python requirement agent turns these decisions into a contract-aware blueprint." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="CURRENT QUESTION" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11" />
                                <TextBlock x:Name="CurrentQuestionText" Text="Loading planning question..." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,18" />
                                <TextBlock Text="Recommended" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBlock x:Name="RecommendationText" Text="—" TextWrapping="Wrap" Margin="0,4,0,14" />
                                <ComboBox x:Name="AnswerOptionsCombo" MinWidth="320" HorizontalAlignment="Left" SelectionChanged="AnswerOptionsCombo_SelectionChanged" />
                                <TextBlock Text="Custom answer" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,16,0,6" />
                                <TextBox x:Name="CustomAnswerBox" MinHeight="40" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="SubmitAnswerButton" Content="Continue" Style="{StaticResource PrimaryButton}" Click="SubmitAnswerButton_Click" Margin="0,0,10,0" />
                                    <Button Content="Restart plan" Click="RestartPlanButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="BlueprintPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="960">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Architecture blueprint" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Text="Generated by the Python architecture agent. Review it before locking contracts." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,14" />
                                <Button x:Name="ApproveBlueprintButton" Content="Approve blueprint and generate contracts" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="ApproveBlueprintButton_Click" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="BlueprintTextBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="520" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ContractsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="960">
                        <Border Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Contract graph" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock Text="Requirement → UI → API → backend → database → tests" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                                <Button Content="Refresh" HorizontalAlignment="Right" Click="RefreshContractsButton_Click" />
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="ContractsList" MinHeight="560" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ImpactPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="920">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Impact analysis" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Text="Trace a requested change through the Python contract graph before touching files." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18" />
                                <TextBlock Text="Target entity / field / route" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox x:Name="TargetEntityBox" Margin="0,6,0,14" />
                                <TextBlock Text="Requested change" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                <TextBox x:Name="ChangeDescriptionBox" Margin="0,6,0,16" MinHeight="90" TextWrapping="Wrap" AcceptsReturn="True" />
                                <Button Content="Analyze impact" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="RunImpactButton_Click" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="ImpactOutputBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="330" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="GitPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="920">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Git safety" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Text="Create recovery checkpoints around multi-file work in the local Python-managed workspace." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="CheckpointNameBox" Width="360" Text="Before change" Margin="0,0,10,0" />
                                    <Button Content="Create checkpoint" Style="{StaticResource PrimaryButton}" Click="CreateCheckpointButton_Click" Margin="0,0,10,0" />
                                    <Button Content="Refresh" Click="RefreshGitButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="CHECKPOINTS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,7" />
                        <ListBox x:Name="CheckpointsList" MinHeight="130" Margin="0,0,0,16" />
                        <TextBlock Text="WORKING DIFF" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,7" />
                        <TextBox x:Name="DiffTextBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AssistantPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Local assistant" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Text="Uses Ollama through the compulsory Python backend when available, with a deterministic offline fallback." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18" TextWrapping="Wrap" />
                                <ComboBox x:Name="ChatLanguageCombo" Width="180" HorizontalAlignment="Left" SelectedIndex="0">
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Tamil" Tag="ta" />
                                    <ComboBoxItem Content="Tanglish" Tag="tanglish" />
                                </ComboBox>
                                <TextBox x:Name="ChatInputBox" Margin="0,14,0,12" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap" />
                                <Button Content="Send" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SendChatButton_Click" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="ChatOutputBox" FontSize="13" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="360" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SystemPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Local system" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock Text="Native desktop status and Python backend capabilities." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,18" />
                                <Button Content="Refresh system status" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="RefreshSystemButton_Click" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="SystemStatusTextBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="480" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="2" Background="#0E1424" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="16,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="ACTIVITY" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" FontSize="10" />
                        <TextBlock Text="Python agent timeline" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,12" />
                    </StackPanel>
                    <ListBox x:Name="ActivityList" Grid.Row="1" BorderThickness="0" Background="Transparent" />
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Backend" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBlock Text="Python · local IPC" FontWeight="SemiBold" Margin="0,3,0,9" />
                            <TextBlock Text="UI" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                            <TextBlock Text="WPF · native Windows" FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
